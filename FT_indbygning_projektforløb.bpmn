  <bpmn:collaboration id="Collaboration_18p92jq">
    <bpmn:participant id="Participant_1re2lev" name="FO KALA" processRef="Process_1yme34u" />
    <bpmn:textAnnotation id="TextAnnotation_11xh24k">
      <bpmn:text>Gate 1: Er der ressourcer?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06nohna">
      <bpmn:text>Gate 2: Er der finansiering?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1pixcel">
      <bpmn:text>Gate 3: Er opgaven analyseret mht. scope/afgrænsning?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11vffe6">
      <bpmn:text>Gate 4: Er der ressourcer?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_135ldzu">
      <bpmn:text>NB: Denne aktivitet handler i høj grad om at iværksætte projektarbejdet og finde og aktivere de rette ressourcer hos FT, men også i de andre kapacitetsansvarlige FO'er (KAMA, KAMU, Space). Dette varetages i dag af Chefingeniøren (Allan), og består af meget opfølgningsarbejde.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0i7px8r">
      <bpmn:text>Her består opgaven i særdeleshed i at: -uppege leads (f.eks. sammen med MILDEF), PoR teams, ressourcesætning, milepælsplanlægning, milepælsleverancer, tidsplaner.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_08bl6gx">
      <bpmn:text>Projektstart: inbygningsbehov foreligger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gjfyq3">
      <bpmn:text>Denne artefakt består som vist af mange støtteartefakter</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sjt3rx">
      <bpmn:text>Formålet med denne lane: Output er et SRS (System Requirement Specification), som systemhuset kan acceptere og arbejde videre med.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1qht90s" associationDirection="None" sourceRef="Gateway_0q62axn" targetRef="TextAnnotation_11xh24k" />
