<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_KabelProces" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_1p06pqk">
    <bpmn:participant id="Participant_0d4etv0" processRef="Process_KabelDesignSpecifikationProduktion" />
    <bpmn:textAnnotation id="TextAnnotation_0mwdvk0">
      <bpmn:text>Gate 1: Er indbygningsopgaven og systemgrundlaget godkendt og finansieret? (Formål: forhindrer, at kabelarbejdet starter på et uafklaret behov)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0i02rt9">
      <bpmn:text>Gate 6: Er designet godkendt? (Formål: At sikre en formel beslutning: godkendelse eller retur til design</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0c8sllc">
      <bpmn:text>Gate 7: Foreligger der en afvigelse eller waiver-anmodning? (Formål: At skelne mellem et standardforløb og et afvigelsesforløb</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mm5f3u">
      <bpmn:text>Er kablet og materialet kodificeret i SAP? (Formål: at afgør om det allerede findes som materiel i SAP)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16196ly">
      <bpmn:text>Startevent: Godkendt indbygningsbehov foreligger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qqhrm3">
      <bpmn:text>Gate 9: Er leverandøren kvalificeret? (Formål: At afgøre om leverandøren må anvendes)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0gdet34">
      <bpmn:text>Formål: Bekræfter formål, platform, omfang og leverancebehov</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04re1wv">
      <bpmn:text>Formål: Gør ejerskab og beslutningskompetence tydelig</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gcm5qa">
      <bpmn:text>Formål: At sikrer mandat til design, indkøb og produktion</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tmc768">
      <bpmn:text>Formål: modtager det endelige kabelgrundlag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rgajj0">
      <bpmn:text>Bemærkning: Rolle i denne lane kan være projektleder, systemansvarlig, produktansvarlig eller tilsvarende. Den konkrete organisatoriske placering skal valideres med FT. Workshoppen peger på et behov for at få det tekniske, juridiske og økonomiske ansvar eksplicit registreret.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nff5zw">
      <bpmn:text>Formål: Sikrer at kabelprocessen kun starter på et legitimt og tilstrækkeligt modnet behov</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qba2s0">
      <bpmn:text>Formål: Sikrer et godkendt teknisk udgangspunkt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11lmexc">
      <bpmn:text>Formål: Kortlægger hvilke systemer, komponenter og grænseflader der skal forbindes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_14ie4ky">
      <bpmn:text>Formål: Angiver eksempelvis container, køretøj, platformtype og miljø</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0p8uwbs">
      <bpmn:text>Gate 2: Findes der allerede et godkendt referencedesign? (Formål: Afgøre om FT kan genbruge et eksisterende standardgrundlag)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bx36z7">
      <bpmn:text>Gate 3: Er arkitektur- og integrationsgrundlaget tilstrækkeligt? (Formål: forhindrer, at kabelspecifikationen starter på et ukendt eller ustabilt integrationsgrundlag)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1z0b5n1">
      <bpmn:text>Formål: Kobler systemer, interfaces og kabeltyper sammen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_03ixhnq">
      <bpmn:text>Formål: Tilpasser et eksisterende design til den konkrete platform eller indbygning</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_13ksh1n">
      <bpmn:text>Formål: Etablerer et nyt generisk kabelgrundlag, hvis der ikke findes et brugbart. Denne aktivitet går herefter direkte videre til aktiviteten "Tilpasning af referencedesign", da nye design altid skal tilpasses til den konkrete platform eller indbygning, for at være logisk konsistente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nfjcjk">
      <bpmn:text>(Indtagsprocessen starter her) Denne lane fastlægger rammen for, hvad kablet skal forbinde, og hvilke standarder, interfaces og arkitekturprincipper der skal overholdes. Centrale dataobjekter: systemarkitektur, platformskontekst, referencedesign, generisk kabelmapping, arkitekturbaseline og integrationsoverblik. Workshoppen antydede systemarkitektur og systemdesign som et forudgående grundlag for specifikation, design og produktion. Det fremhæver også, at nye systemer eller ændringer, der påvirker den samlede baseline, skal håndteres via en change-proces.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04rsjdt">
      <bpmn:text>Formål: Overdrager et godkendt grundlag til kabelspecifikation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_13ud2ir">
      <bpmn:text>Formål: At klassificere som infrastruktur-, last-mile- eller Black Box-kabel</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1v3u3z8">
      <bpmn:text>Vi formoder baseret på workshoppen at dette nok er den mest centrale faglige lane. Den kan repræsentere en eksisterende funktion eller en ønsket fremtidig rolle. Den bør derfor gerne have en BPMN-annotation: “Rolle/funktion og organisatorisk placering skal valideres.” Vi har identidifcerede følgende centrale dataobjekter: ICD, kabeldiagram, kabeliste, kabeltegning, wirediagram, BoM, designspecifikation, produktionsspecifikation, monteringsvejledning, liste over long lead items og foreløbig produktionspakke. Det fremgår af vores workshopnotat, at ICD’en blandt andet skal omfatte stiktype, stiklayout, pinout, overfladebehandling, backshell, keying, vinkling, miljøkrav, mærkning og ansvar. Designet dokumenteres gennem kabeltegning, wirediagram, stykliste og teknisk designspecifikation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0buln8l">
      <bpmn:text>Formål: At samler system-, platform-, miljø-, standard- og brugerkrav</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0obri8e">
      <bpmn:text>Formål: At gøre referencedesignet konkret for platformen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z1ngfg">
      <bpmn:text>Formål: Beskriver interfaces, stik og tekniske grænseflader</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04c7vvh">
      <bpmn:text>Formål: Fastlægger eksempelvis type, stik, pinout, længde og miljøkrav</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18k26hv">
      <bpmn:text>Formål: Beskriver labels, identifikation og fysisk beskyttelse</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_135mxr9">
      <bpmn:text>Formål: Listen samler kabler, længder, connectorer og tilhørende oplysninger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ixaiy9">
      <bpmn:text>Gate 4: Er specifikationen komplet og konsistent? (Formål: At afgøre om kabelgrundlaget kan overgå til design</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vvjo4s">
      <bpmn:text>Formål: At sikre at ICD, kabeldiagram, kabeliste, stik, pinout, længde, miljøkrav og mærkning er tilstrækkeligt afklaret. SPØRGSMÅL: Bør den gå til ICD-aktivitet el. aktivitet om kabelkrav?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1g4lhia">
      <bpmn:text>Formål: At dokumenterer fysisk opbygning og geometri</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jyd287">
      <bpmn:text>Formål: At dokumenterer elektriske forbindelser og pinout</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_041pdeh">
      <bpmn:text>Formål: At samle og redegøre for alle komponenter og materialer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ck6kee">
      <bpmn:text>Formål: At definerer de tekniske designparametre</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0h63w9t">
      <bpmn:text>Formål: At gøre kablet reproducerbart hos en eller flere producenter</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sr6c5w">
      <bpmn:text>Formål: At understøtte produktion og eventuelt efterfølgende indbygning</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10tam0y">
      <bpmn:text>Gate 5: Er designet leverandøruafhængigt og producerbart? Formål: At afgøre om dokumentationen er tilstrækkelig til alternativ produktion)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1u10o10">
      <bpmn:text>Formål: At identificerer komponenter med lang leveringstid hos leverandøren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ci143h">
      <bpmn:text>Afleverer dokumenteret design til faglig kontrol</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1cbj01y">
      <bpmn:text>Formål: At sikrer at en kvalificeret producent kan fremstille kablet på basis af dokumenteret design, BoM og produktionsanvisninger, derfor behovet for en skarp revidering</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_19prak0">
      <bpmn:text>Denne lane repræsenterer det faglige kontrolpunkt mellem design og produktion. Det kan være et formelt kompetencecenter, en 'kabel-KCM' eller en anden godkendelsesfunktion. Den nuværende organisering er uafklaret i vores workshopobservationer og bør derfor markeres som en governance-afklaring. Centrale dataobjekter: Reviewrapport, beslutning om designgodkendelse, waiver/deviation-rapport, godkendt produktionspakke, godkendte standardafvigelser.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1bbh8do">
      <bpmn:text>Sikrer at reviewet sker på ét samlet og versionsstyret grundlag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qmv7aw">
      <bpmn:text>Formål: At sagbehandler kan registrere versionering af review i ESDH system el. lign.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1yx76wj">
      <bpmn:text>Vurderer designets kvalitet, fuldstændighed og gennemførlighed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mj04ja">
      <bpmn:text>Formål: At sikrer sporbarhed fra systemkrav til kabeldesign</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zycz6v">
      <bpmn:text>Vurderer overholdelse af relevante standarder og miljøkrav</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ml78bs">
      <bpmn:text>Sikrer at QC, visuel inspektion og V&amp;V er planlagt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15p0jeo">
      <bpmn:text>Formål: At give den kabelansvarlige ingeniør et korrigerbart reviewgrundlag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1d3lw4n">
      <bpmn:text>Formål: At vurdere konsekvens, risici og mulige kompenserende foranstaltninger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lti9id">
      <bpmn:text>Gate 8: Kan waiver godkendes? (Formål: At afgøre om FT kan acceptere en afvigelse</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0wo5ppj">
      <bpmn:text>Formål: At formalisere beslutning og betingelser</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1lsizyt">
      <bpmn:text>Overdrager versionsstyret grundlag til indkøb og produktion</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1yt7ev5">
      <bpmn:text>Formål: At afvise waiver, med evidens baserede begrundelse</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0y3ixmy">
      <bpmn:text>Formål: At sikre, at afvigelser behandles eksplicit og dokumenteret og at produktpakken kan frigives på den baggrund. Fra denne aktivitet kan produktionspakken gå direkte videre til næste lane, Indkøb og Materialestyring.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1an8jo5">
      <bpmn:text>Denne lane overtager, når det tekniske grundlag er godkendt. Den dækker den kommercielle disposition og det materielle grundlag for at kunne bestille, betale, håndtere og spore kablet. Centrale dataobjekter: leverandørvurdering, due diligence, SAP-stamdata, NATO-/materielnummer, long lead item-liste, leveringsplan, indkøbsordre og produktionspakke. Workshoppen kobler kodificering til et unikt NATO-nummer i SAP, som er en forudsætning for at kunne bestille, betale for, flytte og håndtere materialet. Den fremhæver også leveringstid, pris, produktionskapacitet og LLI’er som centrale forhold.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_170hr5j">
      <bpmn:text>Formål: At modtage den teknisk godkendte dokumentation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_13e90wz">
      <bpmn:text>Formål: At finde mulige producenter, eksempelvis MILDEF eller HUBER+SUHNER</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00plg2x">
      <bpmn:text>Formål: At vurdere kompetence, kvalitet, kapacitet og leveringssikkerhed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16pnujh">
      <bpmn:text>Formål: At sikrer at producenten har dokumenteret kompetence, kapacitet og kvalitetsevne</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0cwcca3">
      <bpmn:text>Formål: At håndterer manglende egnethed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1q2vzu2">
      <bpmn:text>Formål: At opretter stamdata og sikrer forsyningsmæssig håndterbarhed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0x40rtf">
      <bpmn:text>Formål: At opretter de nødvendige identifikations- og kodificeringsoplysninger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17n4vmb">
      <bpmn:text>Tager højde for projektbehov, lager, LLI’er og eventuelle genbestillingspunkter</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1214p3v">
      <bpmn:text>Formål: At afgive en formel bestilling hos leverandøren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1130df1">
      <bpmn:text>Formål: At sende det frigivne grundlag som del af ordre- og kontraktgrundlaget</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1updvzw">
      <bpmn:text>Formål: At modtage dokumenterede tekniske og kommercielle forudsætninger</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_058ocvm">
      <bpmn:text>Formål: At vurderer, om dokumentationen er klar og tilstrækkelig</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0js7dna">
      <bpmn:text>Gate 10: Er produktionsgrundlaget tilstrækkeligt (Formål: At afgøre om produktionen kan begynde)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lr5j6t">
      <bpmn:text>Formål: At håndterer mangler, tvetydigheder eller urealiserbare krav</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00emivw">
      <bpmn:text>Formål: At opdaterer leverandørens produktionsgrundlag efter FT-beslutning</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_013gv26">
      <bpmn:text>Formål: At sikrer kapacitet og komponenttilgængelighed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0a0n459">
      <bpmn:text>Formål: At fremstille kablet i henhold til frigivet design</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_167vso4">
      <bpmn:text>Formål: At leverandøren udfører en intern kvalitetssikring</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0j9jcmz">
      <bpmn:text>Formål: At udfører de aftalte elektriske, mekaniske og andre tests</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jdy4q4">
      <bpmn:text>Gate 11: Er FAI påkrævet? (Formål: Anvendes ved First Article Integration, ny kabeltype, væsentlig designændring eller anden fastlagt trigger)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zwkf8v">
      <bpmn:text>Formål: At udfører og dokumenterer First Article Integration/Inspection, hvis relevant</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dqzvka">
      <bpmn:text>Gate 12: Opfylder produktet og dokumentationen kravene? (Formål: at afgøre om leverancen kan frigives)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1bb8a7t">
      <bpmn:text>Formål: Dette er leverandørens interne frigivelseskontrol før overdragelse til FT og omhandler korrigering, genproduktion eller anmodning om waiver</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1q2e6cu">
      <bpmn:text>Formål: At leverer fysisk kabel og komplet dokumentation til FT</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ysnwa8">
      <bpmn:text>Denne lane bør nok optræde tidligere?, muligvis ligge i en selvstændig leverandørpool med f.eks. message flows til FT, og have hybride aktiviteter med FT. I den nuværende workshopmodel kan den godt vises som en selvstændig lane, fordi fT først og fremmest skal kunne se det samlede end-to-end-forløb, men igen - det er blot en tolkning. Centrale dataobjekter: Ordre, produktionspakke, leverandørafklaring, produktionsplan, QC-records, test reports, FAI-dokumentation, serienummerregister, leverancedokumentation og afvigelsesrapport.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0o36lcg">
      <bpmn:text>Her er det nok afgørende at holde leverandørens interne QC adskilt fra FT’s accept. Leverandørens QC er en del af leverandørens ansvar; FT’s modtagekontrol er en uafhængig kontrol og en formel acceptbeslutning. Centrale dataobjekter: modtagekontrolrapport, visuel inspektionsrapport, testrapporter, FAI-dokumentation, afvigelsesrapport, waiver-beslutning og acceptdokument.
Vi har under workshopen observeret, at Allan beskriver, at FT har visuelle inspektions- og acceptkriterier for kabelmontering, og at leverandørens QA-funktion skal være i overensstemmelse med FT’s specifikationer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1j556o6">
      <bpmn:text>Formål: At overtage leverancen fra leverandøren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1cmtna3">
      <bpmn:text>Formål: At afgøre om varenummer, kabeltype, længde, batch og serienummer stemmer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1whj9fs">
      <bpmn:text>Formål: At sikre sammenhæng mellem kabel, komponenter, dokumenter og serienumre</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ttzcno">
      <bpmn:text>Formål: At verificere, at de påkrævede tests er gennemført</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1f5pghi">
      <bpmn:text>Formål: At udfører den formelle FT modtagekontrol</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1e1u7hd">
      <bpmn:text>Formål: Kontrol der udførelse mod FT’s visuelle acceptkriterier</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qrz901">
      <bpmn:text>Gate 13: Er leverancedokumentationen komplet? (Formål: sikrer at FT ikke accepterer fysisk materiel uden test-, identitets- og sporbarhedsdokumentation)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0l6exhf">
      <bpmn:text>Gate 14: Er leverancen accepteret? (Formål: FT’s formelle acceptbeslutning efter modtagekontrol og visuel inspektion)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1lq1u2y">
      <bpmn:text>Formål: At starte returnering, korrektion eller waiver-forløb</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12j09b5">
      <bpmn:text>Gate 15: Kan afvigelsen accepteres via waiver? (Formål: at afgøre om leverancen kan anvendes med dokumenterede betingelser/afvigelser)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0t0xfpe">
      <bpmn:text>Formål: At udfører den formelle FT modtagekontrol</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_018nezo">
      <bpmn:text>Formål: At Registrerer kontrolresultat, accept og afvigelser</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0u2cks5">
      <bpmn:text>Formål: At frigive kabel til lager/indbygning</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_01hbo48">
      <bpmn:text>Formål: waiver vurderes for stor, så f.eks. returnerering påbegyndes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0n8up4q">
      <bpmn:text>Denne lane dækker den fysiske forsyningskæde efter accept. Den bør være med i modellen, fordi workshoppen peger på, at omlagring og fysisk transport kan være en reel flaskehals, hvorfor det er vigtigt at opnå transparens i også disse forretningsprocesser. Centrale dataobjekter: lagerkvittering, lagerstatus, lokalitetsregistrering, transportordre, plukliste og overdragelseskvittering.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0fg2blr">
      <bpmn:text>Formål: At registrerer og placere kablet  i korrekt lagring efter accept</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jwse8i">
      <bpmn:text>Formål: At sikrer, at den fysiske placering er kendt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1d0i5wp">
      <bpmn:text>Gate 16: Skal kablet omlagres? (Formål: At afgøre om kablet skal flyttes til anden lokation før indbygning)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tm6fck">
      <bpmn:text>Formål: At fastlægge transport, prioritet og destination</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0xii1m3">
      <bpmn:text>Formål: At sikrer korrekt kabel, mængde og dokumentation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_05jrxoy">
      <bpmn:text>Formål: At levere kabel til indbygningssted</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sksdwp">
      <bpmn:text>Gate 17: Er det korrekte kabel og dokumentation samlet til indbygning? (Formål: At forhindrer, at værkstedet modtager forkerte, ufuldstændige eller uidentificerbare komponenter</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1yxsucv">
      <bpmn:text>Formål: At fysisk flytte kablet mellem lagre eller lokationer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1pu7b8x">
      <bpmn:text>Formål: At overdrage kabel til værksted eller indbygningsteam</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jh3qge">
      <bpmn:text>Formål: At udpege mangler i kabelpakken</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15zhh45">
      <bpmn:text>I denne lane ser vi afslutningen på den afgrænsede hovedproces, men samtidig starten på den efterfølgende livscyklusproces. På Lag 1 bør den primært fungere som et tydelig handoff. Men hvis den vises aggregeret (på Lag 2), kan vi jo overveje (sammen med de resterende subprocesser), om vi skal vise subprocessen "Gennemfør kabelindbygning" i en separat Lag 2-proces kaldet "Drift og vedligehold af kabelsystem", og om den bør ligge i en separat livscyklusproces (som en subprocess) "Dekommissionere kabelsystem", som igen bør ligge i sin egen "separat livscyklusproces"? En ekstra ting, der er værd at bemærke: Vi har ikke opnået indblik i de anvendte artefakter til indbygning – dette er et anliggende, der evt. kunne afklares med platformsejer på værksted?!</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0aiovlr">
      <bpmn:text>Formål: En formel handoff fra lager/logistik til indbygningsteam</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_083rbq6">
      <bpmn:text>Gate 18: Er kabel og dokumentation klar til indbygning? (Formål: At kontrollerer at leverancen er komplet og accepteret)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gcnvne">
      <bpmn:text>Formål: Formelt handoff mellem anskaffelsesprocessen og den efterfølgende indbygningsproces</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15op2ld">
      <bpmn:text>Gate 19: Er kablet korrekt installeret? (NB: Denne gateway hører egentlig til den separate subprocess 'gennemføre kabelindbygning' og nok ikke til den afgrænsede hovedproces, men vi må drøfte den med FT)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1eiob2w">
      <bpmn:text>Slutevent: Kabel og dokumentation klar til indbygning</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1esco79">
      <bpmn:text>FT_Hovedproces for kableindbygning, alt udfoldet (til workshop d. 22.09). Bemærk: der vises ingen temporalitet!</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vhmkr3">
      <bpmn:text>PDR &amp; CDR (Preliminary &amp; Critical Design Review)
CDR er slutpunktet i designfasen, der indeholder nødvendige forudgående PDR, og CDR-aktiviteter.
CDR = Design Freeze; designet er fastlåst, og systemhuset producerer nu den aftalte løsning.</bpmn:text>
    </bpmn:textAnnotation>
