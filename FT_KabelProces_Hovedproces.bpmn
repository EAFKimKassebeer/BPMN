  <bpmn:process id="Process_KabelDesignSpecifikationProduktion" name="Design, specifikation og produktion af kabler til indbygningsprojekter i FT" isExecutable="true" camunda:versionTag="1.0.0">
    <bpmn:documentation>
      Hovedproces for design, specifikation og produktion af kabler til indbygningsprojekter i FT.
      Processtart: Godkendt indbygningsbehov foreligger med systemarkitektur.
      Procesafslutning: Kabel og dokumentation er klar til indbygning.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_0fczfux">
      <bpmn:lane id="Lane_1jpk5nz" name="Projekt og systemansvarlig">
        <bpmn:flowNodeRef>Task_ModtagSystemarkitektur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentificerDelsystemer</bpmn:flowNodeRef>
